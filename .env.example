# Copiar a .env (que está en .gitignore) y completar.
# El token SOLO se usa durante la instalación (scripts/download_models.py) para descargar
# modelos con licencia "gated" (Stable Audio). La app en ejecución nunca lo usa.
# Crear en https://huggingface.co/settings/tokens con permiso de lectura (Read).
HF_TOKEN=

# Perfil por defecto de la app: rapido | calidad
STORYBOOK_PROFILE=rapido

# Nivel de log: DEBUG | INFO | WARNING
STORYBOOK_LOG_LEVEL=INFO

# Dirección local de Ollama (no cambiar salvo que se use otro puerto)
OLLAMA_HOST=http://localhost:11434
